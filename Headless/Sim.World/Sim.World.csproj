<Project Sdk="Microsoft.NET.Sdk">

  <!--
    World-loading glue between the data layer (DaggerfallConnect readers) and
    the sim registries. Sources live in Assets/Sim/World so Unity compiles the
    same files; headless they need their own project because Sim.Core must not
    depend on Sim.Data.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>DaggerfallWorkshop.Sim</RootNamespace>
    <AssemblyName>DaggerfallSim.World</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Sim/World/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim.Core/Sim.Core.csproj" />
    <ProjectReference Include="../Sim.Data/Sim.Data.csproj" />
  </ItemGroup>

</Project>
