<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless build of the sim core. Compiles the SAME sources that live under
    Assets/Sim (single source of truth — no copies). LangVersion is 'latest'
    here, but the sources are kept C# 7.3-compatible BY CONVENTION so they stay
    dual-compilable under Unity's compiler — this build will NOT flag C# 8+
    syntax, so that guarantee rests on the Unity compile, not this project.
    Bridge/ is excluded: it is the Unity integration layer and the only part
    of Assets/Sim allowed to reference UnityEngine.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DaggerfallWorkshop.Sim</RootNamespace>
    <AssemblyName>DaggerfallSim</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Sim/Core/**/*.cs" />
    <Compile Include="../../Assets/Sim/Memory/**/*.cs" />
    <Compile Include="../../Assets/Sim/Engine/**/*.cs" />
    <Compile Include="../../Assets/Sim/Events/**/*.cs" />
    <Compile Include="../../Assets/Sim/Registries/**/*.cs" />
    <Compile Include="../../Assets/Sim/Systems/**/*.cs" />
    <Compile Include="../../Assets/Sim/Threading/**/*.cs" />

    <!-- Pure-C# DFU classes the sim depends on (calendar math + shared enums). -->
    <Compile Include="../../Assets/Scripts/Utility/DaggerfallDateTime.cs" />
    <Compile Include="../../Assets/Scripts/DaggerfallUnityEnums.cs" />

    <!-- Shims satisfying DFU sources' using-directives without Unity. -->
    <Compile Include="Shims/*.cs" />
  </ItemGroup>

</Project>
