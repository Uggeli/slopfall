<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Wire protocol for sim clients: pure encode/decode over streams, no
    sockets (transport lives with whoever owns the connection). Targets
    netstandard2.0 so any .NET-capable client - including Godot 4 - can
    reference it together with Sim.Core.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DaggerfallWorkshop.Sim.Net</RootNamespace>
    <AssemblyName>DaggerfallSim.Net</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim.Core/Sim.Core.csproj" />
  </ItemGroup>

</Project>
