<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Sim.AssetExport</AssemblyName>
    <RootNamespace>Sim.AssetExport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sim.Data\Sim.Data.csproj" />
  </ItemGroup>

  <!-- DaggerfallConnect rendering-asset readers. Deliberately NOT in Sim.Data
       (which is logical-data only); this project is the client-side asset
       decode path. Pure C# except for a tiny Color/Mathf shim in Sim.Data. -->
  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\API\DFMesh.cs" />
    <Compile Include="..\..\Assets\Scripts\API\Vector3.cs" />
    <Compile Include="..\..\Assets\Scripts\API\FaceUVTool.cs" />
    <Compile Include="..\..\Assets\Scripts\API\Arch3dPatch.cs" />
    <Compile Include="..\..\Assets\Scripts\API\Arch3dFile.cs" />
    <Compile Include="..\..\Assets\Scripts\API\TextureFile.cs" />
    <Compile Include="..\..\Assets\Scripts\API\BaseImageFile.cs" />
  </ItemGroup>

</Project>
